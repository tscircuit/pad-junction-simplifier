{
  "name": "@tscircuit/pad-junction-simplifier",
  "version": "0.0.1",
  "description": "Direct V-to-T pad junction simplification for PCB routes",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./lib/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.ts",
      "bun": "./lib/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "lib",
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tscircuit/pad-junction-simplifier.git"
  },
  "bugs": {
    "url": "https://github.com/tscircuit/pad-junction-simplifier/issues"
  },
  "homepage": "https://github.com/tscircuit/pad-junction-simplifier#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "test": "bun test --timeout 9999999",
    "typecheck": "tsc --noEmit",
    "build": "tsup lib/index.ts --format esm --dts --sourcemap --clean",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@tscircuit/math-utils": "^0.0.36",
    "@tscircuit/solver-utils": "^0.0.16",
    "circuit-json-to-connectivity-map": "^0.0.19",
    "graphics-debug": "0.0.99"
  },
  "devDependencies": {
    "@types/bun": "^1.2.23",
    "tsup": "^8.3.6",
    "typescript": "^5.9.3"
  }
}
